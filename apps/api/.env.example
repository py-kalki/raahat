# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/raahat?schema=public"

# App & Auth
PORT=4000
JWT_SECRET="raahat_jwt_secret_change_in_production_key_123456789"
JWT_EXPIRES_IN="7d"

# OSRM Routing Service (Public demo server or self-hosted)
OSRM_BASE_URL="https://router.project-osrm.org"

# Firebase Cloud Messaging (Optional for local demo)
FCM_SERVER_KEY=""

# Environment
NODE_ENV="development"
