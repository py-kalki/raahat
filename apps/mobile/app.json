{
  "expo": {
    "name": "Raah",
    "slug": "raahat",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "raahat",
    "splash": {
      "backgroundColor": "#F4F7F5"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F3A2A"
      },
      "package": "com.raahat.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "USE_FULL_SCREEN_INTENT",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Raah requires background location to track emergency corridors and alert traffic officers."
        }
      ]
    ]
  }
}
