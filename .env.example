# Backend API Database & Server Settings (used in apps/api)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/raahat?schema=public"
PORT=4000
JWT_SECRET="raahat_jwt_secret_change_in_production_key_123456789"
JWT_EXPIRES_IN="7d"
OSRM_BASE_URL="https://router.project-osrm.org"
FCM_SERVER_KEY=""
NODE_ENV="development"

# Mobile App Settings (used in apps/mobile)
EXPO_PUBLIC_API_URL="http://localhost:4000"

# GPS Simulator Settings (used in tools/gps-simulator)
API_BASE="http://localhost:4000"
